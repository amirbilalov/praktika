<Window x:Class="SystemInfoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SystemInfoApp.Converters"
        xmlns:models="clr-namespace:SystemInfoApp.Models"
        Title="Параметры окружения компьютера"
        Height="780" Width="1020" MinHeight="600" MinWidth="750"
        Background="#0F0F1A"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        
        <conv:StateToColorConverter      x:Key="StateToColor"/>
        <conv:StateToIconConverter       x:Key="StateToIcon"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <conv:LoadingToVisibilityConverter x:Key="LoadingToVis"/>

        
        <conv:BoolToVisibilityConverter  x:Key="InverseBoolToVis" Invert="True"/>

        
        <Style x:Key="SpinnerStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:LoadingState.Loading}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinSB">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty=
                                        "(UIElement.RenderTransform).(RotateTransform.Angle)"
                                    From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinSB"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
            <RowDefinition Height="48"/>   
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#1A1A2E">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="22" Background="#4A7FD4"
                            CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="Параметры окружения"
                               Foreground="White" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="⟳  Обновить"
                        Command="{Binding RefreshCommand}"
                        Foreground="White"
                        Background="#3A3A5C"
                        BorderBrush="#5A5A8A"
                        BorderThickness="1"
                        Padding="16,8"
                        FontSize="13"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5050A0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        
        <Border Grid.Row="1" Background="#16162A" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ПАРАМЕТР"
                           Foreground="#8888BB" FontSize="12" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="ЗНАЧЕНИЕ"
                           Foreground="#8888BB" FontSize="12" FontWeight="Bold"/>
            </Grid>
        </Border>

        
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0F0F1A">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SystemInfoItem}">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource RowBorder}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A30"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="24,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="#CCCCEE"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Margin="0,2,12,0"/>

                                
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Foreground="#E0E0FF"
                                           FontSize="13"
                                           FontFamily="Consolas, Courier New, monospace"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Margin="0,2,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="{x:Static models:LoadingState.Pending}">
                                                    <Setter Property="Foreground" Value="#555577"/>
                                                    <Setter Property="Text"       Value="—"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="{x:Static models:LoadingState.Loading}">
                                                    <Setter Property="Foreground" Value="#888899"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="{x:Static models:LoadingState.Error}">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                
                                <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0">
                                    
                                    <TextBlock Text="{Binding State, Converter={StaticResource StateToIcon}}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock.Foreground>
                                            <Binding Path="State" Converter="{StaticResource StateToColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    
                                    <TextBlock Text="⟳"
                                               FontSize="18"
                                               Foreground="#F5A623"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SpinnerStyle}"
                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        
        <Border Grid.Row="3" Background="#16162A" BorderBrush="#2A2A3D" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                

                <TextBlock Grid.Column="1"
                           Text="Амир Билалов Практика"
                           Foreground="#44445A"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
